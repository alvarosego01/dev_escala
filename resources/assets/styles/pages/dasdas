on:
  push:
    branches:
      - staging
  
  pull_request:
    branches:
      - staging
    types:
      - opened
      - synchronize
  
  jobs:
    build-and-deploy:
      runs-on: ubuntu-latest
      steps:
        - name: Checkout Repository
          uses: actions/checkout@v4
  
        - name: Archive Build Output
          run: zip -r build.zip dist app config vendor resources composer.json composer.lock
  
        - name: Copy Files to Server (using SCP)
          uses: appleboy/scp-action@master
          with:
            host: ${{ secrets.HOST }}
            username: ${{ secrets.USER }}
            port: ${{ secrets.PORT }}
            source: "build.zip"
            target: "/tmp"
            key: ${{ secrets.PASS }} # Usa la clave privada aquí
  
        - name: Deploy to Server (using SSH)
          uses: appleboy/ssh-action@master
          with:
            host: ${{ secrets.HOST }}
            username: ${{ secrets.USER }}
            port: ${{ secrets.PORT }}
            script: |
              rm -rf /home/escapyzo/domains/escala.website/public_html/wp-content/themes/oceanwp-child
              unzip /tmp/build.zip -d /tmp/build
              mkdir -p /home/escapyzo/domains/escala.website/public_html/wp-content/themes/oceanwp-child
              mv /tmp/build/* /home/escapyzo/domains/escala.website/public_html/wp-content/themes/oceanwp-child
              rm -rf /tmp/build /tmp/build.zip
            key: ${{ secrets.PASS }}
