{% set media_centro_12_sections = fields.media_centro_12_sections %}
{% set media_fondo_completo_12_image = fields.media_fondo_completo_12_image %}

{% set fondocompleto = '' %}  {# Inicializa la variable fondo completo #}

<section class="block_blog_centro_image_fondo_completo_right customSection sectionParent" 
         >

    <div class="section_contain" style="{% if media_centro_12_sections|length > 0 %}
                     {% for item in media_centro_12_sections %}
                         {% set fondocompleto = item.media_fondo_completo_12_image %}  {# Asigna el fondo de la primera sección #}
                         {% if fondocompleto != '' %}
                             background-image: url('{{ get_img(fondocompleto, 'src') }}');
                         {% endif %}
                     {% endfor %}
                 {% endif %}">
        {% if media_centro_12_sections|length > 0 %}
            <section class="innerSectionElement sct2 ">
                {% for item in media_centro_12_sections %}
                    {% set image = item.media_centro_12_image %}

                    <div class="groupElements row">
                        <div class="image">
                            <div class="containerImage">
                                
                                {% if image != '' %}
                                    <img src="{{ get_img(image, 'src') }}" alt="{{ get_img(image, 'alt') }}" loading="lazy">
                                {% endif %}
                                
                            </div>
                        </div>

                    </div>
                {% endfor %}

            </section>
        {% endif %}

    </div>

</section>
