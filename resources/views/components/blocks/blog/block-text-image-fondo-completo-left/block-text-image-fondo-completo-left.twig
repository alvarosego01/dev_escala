{% set media_text_5_title = fields.media_text_5_title %}
{% set media_text_5_subtitle = fields.media_text_5_subtitle %}
{% set media_text_5_sections = fields.media_text_5_sections %}
{% set media_fondo_completo_left_5_image = fields.media_fondo_completo_left_5_image %}

{% set fondocompleto2 = '' %}  {# Inicializa la variable fondo completo #}

<section class="block_blog_text_image_fondo_completo_left customSection sectionParent" 
         style="{% if media_text_5_sections|length > 0 %}
                     {% for item in media_text_5_sections %}
                         {% set fondocompleto2 = item.media_fondo_completo_left_5_image %}  {# Asigna el fondo de la primera sección #}
                         {% if fondocompleto2 != '' %}
                             background-image: url('{{ get_img(fondocompleto2, 'src') }}');
                         {% endif %}
                     {% endfor %}
                 {% endif %}">

    <div class="section_contain">

        {% if media_text_5_sections|length > 0 %}
            <section class="innerSectionElement sct2 ">

                {% for item in media_text_5_sections %}

                    {% set title = item.media_text_5_title %}
                    {% set description = item.media_text_5_description %}
                    {% set image = item.media_text_5_image %}
                    {% set side = item.media_text_5_side %}
                    {% set i = i + 1 %}

                    <div class="groupElements row element_{{ i }} {{ side }}">

                        <div class="info col-md-12 col-lg-6">

                            {% if title != '' %}
                                <h3 class="secondaryTitle">
                                    {{ title|raw }}
                                </h3>
                            {% endif %}

                            {% if description != '' %}
                                <div class="text">
                                    {{ description|raw }}
                                </div>
                            {% endif %}

                        </div>

                        <div class="image col-md-12 col-lg-6">
                            <div class="containerImage">
                                
                                {% if image != '' %}
                                    <img src="{{ get_img(image, 'src') }}" alt="{{ get_img(image, 'alt') }}" loading="lazy">
                                {% endif %}
                                
                            </div>
                        </div>

                    </div>
                {% endfor %}

            </section>
        {% endif %}

    </div>

</section>
