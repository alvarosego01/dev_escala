{% set media_text_1_title_button_button = fields.media_text_1_title_button %}
{% set media_text_1_subtitle_button = fields.media_text_1_subtitle_button %}
{% set media_text_1_sections_button = fields.media_text_1_sections_button %}
{% set button_text = fields.media_text_1_button_text %}

<section class="block_blog_text_image_button customSection sectionParent ">

	<div
		class="section_contain">

		{# {% if media_text_1_title != '' or media_text_1_title != '' %}
					<section class="innerSectionElement sct1 ">
						<div class="sectionElements">
		
							{% if media_text_1_title != '' _button%}
								<h2>
									{{ media_text_1_title }}
								</h2>
							{% endif %}
		
							{% if media_text_1_subtitle != '' %}
								<p class="text">
									{{ media_text_1_subtitle }}
								</p>
							{% endif %}
		
						</div>
					</section>
				{% endif %} #}

		{% if media_text_1_sections_button|length > 0 %}
			<section class="innerSectionElement sct2 ">

				{% for item in media_text_1_sections_button %}

					{% set title = item.media_text_1_title_button %}
					{% set description = item.media_text_1_description_button %}
					{% set image = item.media_text_1_image_button %}
					{% set side = item.media_text_1_side_button  %}

					{% set i = i + 1 %}

					<div class="groupElements row element_{{ i }} {{ side }}">

						<div class="info col-md-12 col-lg-6">

							{% if title != '' %}
								<h2 class="secondaryTitle">
									{{ title|raw }}
								</h2>
							{% endif %}

							{% if description != '' %}
								<div class="text">
									{{ description|raw }}
								</div>
							{% endif %}

						</div>

						<div class="image col-md-12 col-lg-6">
							<div class="containerImage">

								{% if image != '' %}
									<img src="{{ get_img(image, 'src') }}" alt="{{ get_img(image, 'alt') }}" loading="lazy">
								{% endif %}

							</div>
						</div>

					</div>
				{% endfor %}

			</section>
			<div class="btnCenter">
				<a class="primaryButton hoverInEffect openPopUpButton popup-general-demo-2022">
					{{ button_text|default('Texto dinamico de boton') }}
				</a>
			</div>

		{% endif %}

	</div>

</section>
