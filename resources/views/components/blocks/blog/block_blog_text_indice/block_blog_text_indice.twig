{% set text_indice_3_title = fields.text_indice_3_title %}
{% set text_indice_3_parag = fields.text_indice_3_parag %}
{% set text_indice_3_background_color = fields.text_indice_3_background_color %}
{% set text_indice_3_title_color = fields.text_indice_3_title_color %}
{% set text_indice_3_parag_color = fields.text_indice_3_parag_color %}
<section class="w-full block_blog_text_indice customSection sectionParent">
	<div class="section_contain">
	<section class="innerSectionElement sct1" style="background-color: {{ text_indice_3_background_color|trim }};">


			<div class="containElements">
				{% if text_indice_3_title != '' %}
					<h3 class="primaryTitle" style="color: #{{ text_indice_3_title_color|replace({'#': ''}) }};">

						{{ text_indice_3_title|raw }}
					</h3>
				{% endif %}

				{% if text_indice_3_parag != '' %}
					<div class="textContent" style="color: #{{ text_indice_3_parag_color|replace({'#': ''}) }};">

						<style>
							.textContent a {
								color: {{text_indice_3_parag_color|default('#F34F36')}}
								;
							}
						</style>
						{{ text_indice_3_parag|raw }}
					</div>
				{% endif %}
			</div>
		</section>
	</div>
</section>
{{ dump(text_indice_3_background_color) }}
