{% set media_centro_8_sections = fields.media_centro_8_sections %}

<section class="block_text_dual_tabla customSection sectionParent">
    <div class="section_contain">
        {% if media_centro_8_sections|length > 0 %}
            {% for item in media_centro_8_sections %}
                {% set texto_1 = item.texto_1 %}
                {% set texto_2 = item.texto_2 %}
                <div class="dualSection">
                    <div class="textContainer textLeft">
                        {% if texto_1 != '' %}
                            {{ texto_1|raw }}
                        {% endif %}
                    </div>

                    <div class="textContainer textRight">
                        {% if texto_2 != '' %}
                            {{ texto_2|raw }}
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
</section>